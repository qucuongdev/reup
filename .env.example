WORKSPACE_DIR=workspace
# External source checkout, containing cli.py (no bundled GUI executable).
PYVIDEOTRANS_PATH=D:/Tools/pyvideotrans
PYVIDEOTRANS_PYTHON=D:/Tools/pyvideotrans/.venv/Scripts/python.exe
# process by default; thread is CPU-only compatibility for restricted Windows named pipes.
PYVIDEOTRANS_EXECUTOR=process
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp
DEFAULT_SOURCE_LANGUAGE=zh-cn
DEFAULT_TARGET_LANGUAGE=vi
DEFAULT_VOICE=vi-VN-HoaiMyNeural
ASR_MODEL=small
ASR_PROVIDER=0
# Numeric CLI provider ID. Run external cli.py --list providers to confirm.
TRANSLATION_PROVIDER=0
TRANSLATION_API_KEY=
# Runtime config parameter name, e.g. chatgpt_key, deepseek_key.
TRANSLATION_API_KEY_FIELD=
TRANSLATION_API_URL=
TRANSLATION_API_URL_FIELD=
TRANSLATION_MODEL=
TRANSLATION_MODEL_FIELD=
TTS_PROVIDER=0
USE_CUDA=false
PROCESS_TIMEOUT_SECONDS=7200
MAX_DOWNLOAD_BYTES=2147483648
MAX_VIDEO_SECONDS=14400
MAX_WATERMARK_BYTES=10485760
# Optional Unicode TTF. Defaults to Windows Arial / Linux DejaVu Sans.
FONT_PATH=
